{
	":configurator:resource-version": 1,

	"persistence.mongo.client~playground": {
		"ident": "playground",
		"connectionString": "mongodb://localhost:27017"
	},

	"persistence.mongo.database~playground": {
		"alias": "playground",
		"database": "playground",
		"client.target": "(mongo.client.ident=playground)"
	},

	"fennec.repository.mongo~playground": {
		"repositoryId": "playground",
		"database.target": "(mongo.database.alias=playground)"
	}
}
