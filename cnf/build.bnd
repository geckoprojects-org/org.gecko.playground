# We include setups for
#	Eclipse Fennec base setup - fennec
#	OSGi-Test / JUnit5 support - fennecTest
#	Eclipse Fennec EMF OSGi - fennecEMF
#	Eclipse Fennec Codec / Persistence (Mongo) - fennecCodec, fennecPersistence
# The remaining gecko libraries have no Eclipse Fennec counterpart yet.
# Gecko bundles that still use the GeckoEMF API run on top of Fennec EMF via
# org.eclipse.fennec.emf.gecko.compatibility.api.

-library: \
	fennec,\
	fennecTest,\
	fennecEMF,\
	fennecCodec,\
	fennecPersistence,\
	geckoBndEclipse,\
	geckoVaadin,\
	geckoSearch

# Needed because we enabled library 'fennec'
github-orga: geckoprojects-org
github-project: org.gecko.playground
base-version: 1.0.0

-fixupmessages \
  "No metadata for revision";is:=ignore

# Maven Central Group-Id
-groupid: org.gecko.playground
-noimportjava: true

# No simultanious release - We only release new version to Maven Central
#releaseNotNeeded: ${findproviders;osgi.identity;(&(osgi.identity=${bsn})(version=${version}));REPOS}

# If release not needed is empty, no Bundle has been found and for maven we do a release to the remote Repo. If not, we only do a release to the local .m2 Repo
#-maven-release.local: ${if;${def;releaseNotNeeded};local;remote}

javac.source: 21
javac.target: 21

-require-bnd: "(version>=7.2.0)"

-plugin.Central: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl="https://central.sonatype.com/repository/maven-snapshots/"; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/central.maven; \
        readOnly=true; \
        poll.time=-1; \
        name="Central"

-plugin.Local: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Local; \
		pretty = true; \
		local = ${build}/local

-plugin.Temp: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Temp; \
		pretty = true; \
		local = ${build}/cache/temp
		
-use-emf: false	
	
# Default build path when using EMF and Eclipse Fennec EMF
emf.lib: \
	org.osgi.service.component.annotations;version=1.4,\
	org.osgi.framework;version=1.9,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest
	
-buildpath.emf: ${if;${-use-emf};${emf.lib}}

