# OSGi variant of the greetings application: the same api/impl/rest bundles
# that the Spring Boot application uses, wired by DS and served by the
# Eclipse OSGi Technology Jakarta REST whiteboard (Jersey on Jetty).
#
# Run (from the parent directory):
#        mvn verify bnd-run:run -pl org.gecko.playground.greetings.osgi.application -am
# Try:   http://localhost:8080/greeting?name=OSGi

-runfw: org.eclipse.osgi
-runee: JavaSE-17

-resolve.effective: active

# The whiteboard runs its own Jetty and is configured through the Configurator
# (config/configuration.json). The Felix HTTP Jetty bundle is only there for
# the servlet API, so its own HTTP connector is switched off.
# eclipse.consoleLog prints OSGi log errors (DS, Configurator) to the console.
-runproperties: \
	configurator.initial=file:${.}/config/configuration.json,\
	logback.configurationFile=${.}/config/logback.xml,\
	org.apache.felix.http.enable=false,\
	eclipse.consoleLog=true

-runrequires: \
	bnd.identity;id='org.gecko.playground.greetings.rest',\
	bnd.identity;id='org.gecko.playground.greetings.impl',\
	bnd.identity;id='org.gecko.playground.greetings.osgi.json',\
	bnd.identity;id='org.eclipse.osgitech.rest.jetty',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell'

-runbundles: \
	ch.qos.logback.classic;version='[1.4.11,1.4.12)',\
	ch.qos.logback.core;version='[1.4.11,1.4.12)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.15.3,2.15.4)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.15.3,2.15.4)',\
	com.fasterxml.jackson.core.jackson-databind;version='[2.15.3,2.15.4)',\
	com.fasterxml.jackson.jakarta.rs.jackson-jakarta-rs-base;version='[2.15.3,2.15.4)',\
	com.fasterxml.jackson.jakarta.rs.jackson-jakarta-rs-json-provider;version='[2.15.3,2.15.4)',\
	jakarta.activation-api;version='[2.1.2,2.1.3)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.1,4.0.2)',\
	javassist;version='[3.29.2,3.29.3)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.8,1.3.9)',\
	org.apache.felix.configadmin;version='[1.9.22,1.9.23)',\
	org.apache.felix.configurator;version='[1.0.8,1.0.9)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty;version='[5.0.4,5.0.5)',\
	org.apache.felix.http.servlet-api;version='[2.1.0,2.1.1)',\
	org.apache.felix.scr;version='[2.2.6,2.2.7)',\
	org.eclipse.osgitech.rest;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.jetty;version='[1.2.3,1.2.4)',\
	org.eclipse.osgitech.rest.sse;version='[1.2.3,1.2.4)',\
	org.gecko.playground.greetings.api;version='[1.0.0,1.0.1)',\
	org.gecko.playground.greetings.impl;version='[1.0.0,1.0.1)',\
	org.gecko.playground.greetings.osgi.json;version='[1.0.0,1.0.1)',\
	org.gecko.playground.greetings.rest;version='[1.0.0,1.0.1)',\
	org.gecko.playground.greetings.spring.context;version='[1.0.0,1.0.1)',\
	org.glassfish.hk2.api;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.external.aopalliance-repackaged;version='[3.0.5,3.0.6)',\
	org.glassfish.hk2.locator;version='[3.0.4,3.0.5)',\
	org.glassfish.hk2.osgi-resource-locator;version='[1.0.3,1.0.4)',\
	org.glassfish.hk2.utils;version='[3.0.5,3.0.6)',\
	org.glassfish.jersey.containers.jersey-container-servlet;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.containers.jersey-container-servlet-core;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-client;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-common;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.core.jersey-server;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.inject.jersey-hk2;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.media.jersey-media-jaxb;version='[3.1.3,3.1.4)',\
	org.glassfish.jersey.media.jersey-media-sse;version='[3.1.3,3.1.4)',\
	org.objectweb.asm;version='[9.6.0,9.6.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.service.jakartars;version='[2.0.0,2.0.1)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.9,2.0.10)'
